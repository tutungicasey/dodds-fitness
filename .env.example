# Copy to .env.local and fill in. Never commit real keys.
# Stripe (TEST mode). Leave blank to use the clearly-labelled DEMO payment flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to "true" only when you deliberately go live with sk_live_ keys.
STRIPE_ALLOW_LIVE=false
# Public base URL used for Stripe redirect URLs (e.g. https://app.doddsfitness.com.au)
APP_URL=http://localhost:3100
# Extra origins allowed to call server actions when behind a proxy/tunnel (comma separated hostnames)
ALLOWED_ORIGINS=
# Cookie "Secure" flag. Defaults to true in production builds.
COOKIE_SECURE=
# SQLite location
DATABASE_PATH=./data/dodds.db
# Set to false to skip demo data seeding on an empty database
SEED_DEMO=true
